/*  Light Theme */
QMainWindow, QWidget {
    background-color: #f7f7f5;
    color: #1c1c1a;
    font-family: "Segoe UI", "SF Pro Text", Ubuntu, sans-serif;
    font-size: 13px;
}

#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e6e5e1;
}

#SidebarLogo {
    color: #1c1c1a;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 8px 4px;
}

#NavButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #6b6b66;
    padding: 10px 14px;
    text-align: left;
    font-size: 13px;
}

#NavButton:hover { background-color: #f1f0ec; color: #1c1c1a; }
#NavButton:checked { background-color: #ecebe7; color: #1c1c1a; font-weight: bold; }

#PrimaryButton {
    background-color: #1c1c1a;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: bold;
}

#PrimaryButton:hover { background-color: #000000; }
#PrimaryButton:disabled { background-color: #e6e5e1; color: #9a9a94; }

#SecondaryButton {
    background-color: transparent;
    color: #1c1c1a;
    border: 1px solid #1c1c1a;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: bold;
}

#SecondaryButton:hover { background-color: #ecebe7; }

#DangerButton {
    background-color: #ef4444;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: bold;
}

#DangerButton:hover { background-color: #dc2626; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #e6e5e1;
    border-radius: 6px;
    color: #1c1c1a;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus { border-color: #1c1c1a; }

QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #e6e5e1;
    border-radius: 6px;
    color: #1c1c1a;
    padding: 8px;
    font-family: "JetBrains Mono", "Consolas", "Courier New", monospace;
    font-size: 12px;
}

QProgressBar {
    background-color: #e6e5e1;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk { background-color: #1c1c1a; border-radius: 4px; }

QLabel { color: #1c1c1a; }

#SectionTitle {
    font-size: 20px;
    font-weight: bold;
    color: #1c1c1a;
    padding-bottom: 8px;
}

#SectionSubtitle {
    font-size: 14px;
    color: #6b6b66;
    padding-bottom: 16px;
}

#CardWidget {
    background-color: #ffffff;
    border: 1px solid #e6e5e1;
    border-radius: 12px;
    padding: 16px;
}

#CardWidget:hover {
    border-color: #d6d5d0;
    background-color: #fafaf8;
}

QCheckBox { color: #6b6b66; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 4px; border: 1px solid #e6e5e1; background: #ffffff; }
QCheckBox::indicator:checked { background: #1c1c1a; border-color: #1c1c1a; }
QCheckBox::indicator:hover { border-color: #1c1c1a; }

QScrollBar:vertical { background: transparent; width: 8px; border: none; }
QScrollBar::handle:vertical { background: #d6d5d0; border-radius: 4px; min-height: 40px; }
QScrollBar::handle:vertical:hover { background: #9a9a94; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 8px; border: none; }
QScrollBar::handle:horizontal { background: #d6d5d0; border-radius: 4px; min-width: 40px; }
QScrollBar::handle:horizontal:hover { background: #9a9a94; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QTreeWidget {
    background-color: #ffffff;
    border: 1px solid #e6e5e1;
    border-radius: 8px;
    color: #1c1c1a;
    padding: 4px;
}

QTreeWidget::item { padding: 4px 8px; border-radius: 4px; }
QTreeWidget::item:hover { background-color: #f1f0ec; }
QTreeWidget::item:selected { background-color: #ecebe7; color: #1c1c1a; }

QHeaderView::section {
    background-color: #f7f7f5;
    color: #6b6b66;
    border: none;
    border-bottom: 1px solid #e6e5e1;
    padding: 8px;
    font-weight: bold;
}

QTabWidget::pane { border: 1px solid #e6e5e1; border-radius: 8px; background: #f7f7f5; }
QTabBar::tab {
    background: transparent;
    color: #6b6b66;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #1c1c1a; border-bottom-color: #1c1c1a; }
QTabBar::tab:hover { color: #1c1c1a; }

QSplitter::handle { background: #e6e5e1; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QToolTip {
    background-color: #ffffff;
    color: #1c1c1a;
    border: 1px solid #e6e5e1;
    border-radius: 4px;
    padding: 4px 8px;
}

QGroupBox {
    border: 1px solid #e6e5e1;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1c1c1a;
}

QLabel { background: transparent; }
