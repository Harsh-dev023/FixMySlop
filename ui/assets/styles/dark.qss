/* CodeRift Dark Theme */
QMainWindow, QWidget {
    background-color: #121211;
    color: #ecebe7;
    font-family: "Segoe UI", "SF Pro Text", Ubuntu, sans-serif;
    font-size: 13px;
}

#Sidebar {
    background-color: #0e0e0d;
    border-right: 1px solid #1f1f1d;
}

#SidebarLogo {
    color: #ecebe7;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 8px 4px;
}

#NavButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #a3a29c;
    padding: 10px 14px;
    text-align: left;
    font-size: 13px;
}

#NavButton:hover { background-color: #1a1a19; color: #ecebe7; }
#NavButton:checked { background-color: #2b2b29; color: #ecebe7; font-weight: bold; }

#PrimaryButton {
    background-color: #ecebe7;
    color: #121211;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: bold;
}

#PrimaryButton:hover { background-color: #ecebe7; }
#PrimaryButton:disabled { background-color: #262624; color: #5a5954; }

#SecondaryButton {
    background-color: transparent;
    color: #ecebe7;
    border: 1px solid #ecebe7;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: bold;
}

#SecondaryButton:hover { background-color: #2b2b29; }

#DangerButton {
    background-color: #FF4444;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: bold;
}

#DangerButton:hover { background-color: #cc3636; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #1a1a19;
    border: 1px solid #2e2e2b;
    border-radius: 6px;
    color: #ecebe7;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus { border-color: #ecebe7; }

QTextEdit, QPlainTextEdit {
    background-color: #1a1a19;
    border: 1px solid #2e2e2b;
    border-radius: 6px;
    color: #ecebe7;
    padding: 8px;
    font-family: "JetBrains Mono", "Consolas", "Courier New", monospace;
    font-size: 12px;
}

QProgressBar {
    background-color: #1a1a19;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk { background-color: #ecebe7; border-radius: 4px; }

QLabel { color: #ecebe7; }

#SectionTitle {
    font-size: 20px;
    font-weight: bold;
    color: #ecebe7;
    padding-bottom: 8px;
}

#SectionSubtitle {
    font-size: 14px;
    color: #a3a29c;
    padding-bottom: 16px;
}

#CardWidget {
    background-color: #161615;
    border: 1px solid #1f1f1d;
    border-radius: 12px;
    padding: 16px;
}

#CardWidget:hover {
    border-color: #2e2e2b;
}

QCheckBox { color: #a3a29c; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 4px; border: 1px solid #2e2e2b; background: #1a1a19; }
QCheckBox::indicator:checked { background: #ecebe7; border-color: #ecebe7; }
QCheckBox::indicator:hover { border-color: #ecebe7; }

QScrollBar:vertical { background: transparent; width: 8px; border: none; }
QScrollBar::handle:vertical { background: #2e2e2b; border-radius: 4px; min-height: 40px; }
QScrollBar::handle:vertical:hover { background: #3a3a37; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 8px; border: none; }
QScrollBar::handle:horizontal { background: #2e2e2b; border-radius: 4px; min-width: 40px; }
QScrollBar::handle:horizontal:hover { background: #3a3a37; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QTreeWidget {
    background-color: #121211;
    border: 1px solid #1f1f1d;
    border-radius: 8px;
    color: #ecebe7;
    padding: 4px;
}

QTreeWidget::item { padding: 4px 8px; border-radius: 4px; }
QTreeWidget::item:hover { background-color: #1a1a19; }
QTreeWidget::item:selected { background-color: #2b2b29; color: #ecebe7; }

QHeaderView::section {
    background-color: #161615;
    color: #a3a29c;
    border: none;
    border-bottom: 1px solid #1f1f1d;
    padding: 8px;
    font-weight: bold;
}

QTabWidget::pane { border: 1px solid #1f1f1d; border-radius: 8px; background: #121211; }
QTabBar::tab {
    background: transparent;
    color: #a3a29c;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #ecebe7; border-bottom-color: #ecebe7; }
QTabBar::tab:hover { color: #ecebe7; }

QSplitter::handle { background: #1f1f1d; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QToolTip {
    background-color: #1a1a19;
    color: #ecebe7;
    border: 1px solid #2e2e2b;
    border-radius: 4px;
    padding: 4px 8px;
}

QGroupBox {
    border: 1px solid #1f1f1d;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #ecebe7;
}

QLabel { background: transparent; }
